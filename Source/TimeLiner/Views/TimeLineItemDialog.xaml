<ui:BaseRibbonWindow
    x:Class="TimeLiner.Views.TimeLineItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:TimeLiner.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TimeLiner.ViewModels"
    xmlns:ui="clr-namespace:TimeLiner.UI"
    Background="{DynamicResource WindowBackgroundBrush}"
    Title="{Binding Path=Title}"
    Width="600"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d"
    >

    <ui:BaseRibbonWindow.Resources>
        <c:ColorToBrushConverter x:Key="ColorBrush" />
        <c:ColorToNameConverter x:Key="ColorName" />
    </ui:BaseRibbonWindow.Resources>

    <StackPanel Margin="10" VerticalAlignment="Top">
        <Grid>
            <Grid.Resources>
                <Style TargetType="{x:Type Label}" BasedOn="{StaticResource LabelStyle}">
                    <Setter Property="Margin" Value="0,5,0,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxStyle}">
                    <Setter Property="Margin" Value="0,5,0,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                        <Trigger Property="Validation.HasError" Value="true">
                            <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)/ErrorContent}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBoxStyle}">
                    <Setter Property="Margin" Value="0,5,0,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasTimeLineName, Mode=OneTime}" Value="False">
                            <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=TextBoxTimeLineName}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasTimeLineName, Mode=OneTime}" Value="True">
                            <Setter Property="FocusManager.FocusedElement" Value="{Binding ElementName=TextBoxTimeLineItemName}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0">Timeline</Label>
            <TextBox
                x:Name="TextBoxTimeLineName"
                Grid.Row="0"
                Grid.Column="1">
                <Binding
                    Mode="TwoWay"
                    Path="TimeLineName"
                    UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <DataErrorValidationRule />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>

            <Label Grid.Row="1" Grid.Column="0">Item</Label>
            <TextBox
                x:Name="TextBoxTimeLineItemName"
                Grid.Row="1"
                Grid.Column="1"
                Focusable="True">
                <Binding
                    Mode="TwoWay"
                    Path="TimeLineItemName"
                    UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <DataErrorValidationRule />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>

            <Label Grid.Row="2" Grid.Column="0">Start</Label>
            <TextBox Grid.Row="2" Grid.Column="1">
                <Binding
                    Mode="TwoWay"
                    Path="StartTime"
                    UpdateSourceTrigger="LostFocus">
                    <Binding.ValidationRules>
                        <DataErrorValidationRule />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>

            <Label Grid.Row="3" Grid.Column="0">End</Label>
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                IsEnabled="{Binding Path=IsTimeSpan}">
                <Binding
                    Mode="TwoWay"
                    Path="EndTime"
                    UpdateSourceTrigger="LostFocus">
                    <Binding.ValidationRules>
                        <DataErrorValidationRule />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <CheckBox
                Grid.Row="3"
                Grid.Column="2"
                IsChecked="{Binding Path=IsTimeSpan, Mode=TwoWay}" />

            <Label Grid.Row="4" Grid.Column="0">Color</Label>
            <StackPanel
                Grid.Row="4"
                Grid.Column="1"
                Orientation="Horizontal">
                <Button Click="ColorButton_Click">
                    <Button.Template>
                        <ControlTemplate>
                            <Rectangle
                                x:Name="RectangleColor"
                                Width="25"
                                Height="25"
                                VerticalAlignment="Center"
                                Fill="{Binding Path=Color, Converter={StaticResource ColorBrush}}"
                                Stroke="{StaticResource ColorBorderBrush}"
                                />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBox
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    IsReadOnly="True"
                    Text="{Binding Path=Color, Mode=OneWay, Converter={StaticResource ColorName}}"
                    TextWrapping="NoWrap" 
                    />
            </StackPanel>
        </Grid>

        <StackPanel
            Margin="0,25,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="5"
                Click="OkButton_Click"
                Content="OK"
                Style="{StaticResource DialogButtonStyle}"
                IsDefault="True" 
                />
            <Button
                Width="80"
                Margin="5"
                Click="CancelButton_Click"
                Content="Cancel" 
                Style="{StaticResource DialogButtonStyle}"
                />
        </StackPanel>
    </StackPanel>
</ui:BaseRibbonWindow>
