<ui:BaseRibbonWindow
    x:Class="TimeLiner.Views.ColorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:TimeLiner.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"    
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TimeLiner.ViewModels"
    xmlns:ui="clr-namespace:TimeLiner.UI"
    Title="Color"
    Width="630"
    Height="360"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d"
    >

    <ui:BaseRibbonWindow.Resources>
        <c:ColorToBrushConverter x:Key="ColorBrush" />
        <DataTemplate x:Key="ColorItemTemplate">
            <Border Width="28" Height="24" Margin="1" Padding="1"
                    Background="Transparent"
                    BorderBrush="{StaticResource ColorBorderBrush}"
                    BorderThickness="1"
                    ToolTip="{Binding Hex}">
                <Rectangle Fill="{Binding Color, Converter={StaticResource ColorBrush}}" />
            </Border>
        </DataTemplate>
        <Style x:Key="ColorListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ItemTemplate" Value="{StaticResource ColorItemTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="DodgerBlue" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorFamilyPanelStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </ui:BaseRibbonWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Style="{StaticResource ColorFamilyPanelStyle}">
                <!--<TextBlock Margin="3,0,0,2" FontSize="14" Text="Reds" />-->
                <ListBox x:Name="ListBoxReds" Tag="Reds" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Style="{StaticResource ColorFamilyPanelStyle}">
                <!--<TextBlock Margin="3,0,0,2" FontSize="14" Text="Oranges" />-->
                <ListBox x:Name="ListBoxOranges" Tag="Oranges" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2" Style="{StaticResource ColorFamilyPanelStyle}">
                <!--<TextBlock Margin="3,0,0,2" FontSize="14" Text="Yellows" />-->
                <ListBox x:Name="ListBoxYellows" Tag="Yellows" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="3" Style="{StaticResource ColorFamilyPanelStyle}">
                <!--<TextBlock Margin="3,0,0,2" FontSize="14" Text="Grays" />-->
                <ListBox x:Name="ListBoxGrayscale" Tag="Grayscale" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Style="{StaticResource ColorFamilyPanelStyle}">
                <!--<TextBlock Margin="3,0,0,2" FontSize="14" Text="Greens" />-->
                <ListBox x:Name="ListBoxGreens" Tag="Greens" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Style="{StaticResource ColorFamilyPanelStyle}">
                <!--<TextBlock Margin="3,0,0,2" FontSize="14" Text="Cyans" />-->
                <ListBox x:Name="ListBoxCyans" Tag="Cyans" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2" Style="{StaticResource ColorFamilyPanelStyle}">
                <!--<TextBlock Margin="3,0,0,2" FontSize="14" Text="Blues" />-->
                <ListBox x:Name="ListBoxBlues" Tag="Blues" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="3" Style="{StaticResource ColorFamilyPanelStyle}">
                <!--<TextBlock Margin="3,0,0,2" FontSize="14" Text="Violets" />-->
                <ListBox x:Name="ListBoxViolets" Tag="Violets" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="5"
                Click="OkButton_Click"
                Content="OK"
                IsDefault="True" 
                Style="{StaticResource DialogButtonStyle}"
                />
            <Button
                Width="80"
                Margin="5"
                Click="CancelButton_Click"
                Content="Cancel" 
                Style="{StaticResource DialogButtonStyle}"
                />
        </StackPanel>
    </Grid>
</ui:BaseRibbonWindow>
