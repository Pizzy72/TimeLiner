<ui:BaseRibbonWindow
    x:Class="TimeLiner.Views.ColorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:TimeLiner.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"    
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TimeLiner.ViewModels"
    xmlns:ui="clr-namespace:TimeLiner.UI"
    Background="{DynamicResource WindowBackgroundBrush}"
    Title="Color"
    Width="368"
    Height="285"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d"
    >

    <ui:BaseRibbonWindow.Resources>
        <c:ColorToBrushConverter x:Key="ColorBrush" />
        <DataTemplate x:Key="ColorItemTemplate">
            <Border Width="28" Height="24" Margin="1" Padding="1"
                    Background="Transparent"
                    BorderBrush="{StaticResource ColorBorderBrush}"
                    BorderThickness="1"
                    ToolTip="{Binding Hex}">
                <Rectangle Fill="{Binding Color, Converter={StaticResource ColorBrush}}" />
            </Border>
        </DataTemplate>
        <Style x:Key="ColorListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ItemTemplate" Value="{StaticResource ColorItemTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="DodgerBlue" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GrayscaleListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource ColorListBoxStyle}">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Width="336" Columns="8" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:BaseRibbonWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Width="336" Columns="8" HorizontalAlignment="Left">
            <ListBox x:Name="ListBoxReds" Grid.Column="0" Tag="Reds" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            <ListBox x:Name="ListBoxOranges" Grid.Column="1" Tag="Oranges" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            <ListBox x:Name="ListBoxYellows" Grid.Column="2" Tag="Yellows" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            <ListBox x:Name="ListBoxGreens" Grid.Column="3" Tag="Greens" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            <ListBox x:Name="ListBoxCyans" Grid.Column="4" Tag="Cyans" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            <ListBox x:Name="ListBoxBlues" Grid.Column="5" Tag="Blues" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            <ListBox x:Name="ListBoxViolets" Grid.Column="6" Tag="Violets" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
            <ListBox x:Name="ListBoxMagentas" Grid.Column="7" Tag="Magentas" Style="{StaticResource ColorListBoxStyle}" MouseDoubleClick="ListBoxColors_MouseDoubleClick" SelectionChanged="ListBoxColors_SelectionChanged" />
        </UniformGrid>

        <ListBox
            x:Name="ListBoxGrayscale"
            Grid.Row="1"
            Margin="0,-2,0,0"
            Tag="Grayscale"
            Style="{StaticResource GrayscaleListBoxStyle}"
            MouseDoubleClick="ListBoxColors_MouseDoubleClick"
            SelectionChanged="ListBoxColors_SelectionChanged" />

        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="5"
                Click="OkButton_Click"
                Content="OK"
                IsDefault="True" 
                Style="{StaticResource DialogButtonStyle}"
                />
            <Button
                Width="80"
                Margin="5"
                Click="CancelButton_Click"
                Content="Cancel" 
                Style="{StaticResource DialogButtonStyle}"
                />
        </StackPanel>
    </Grid>
</ui:BaseRibbonWindow>
