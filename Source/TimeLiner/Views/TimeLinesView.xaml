<UserControl
    x:Class="TimeLiner.Views.TimeLinesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:TimeLiner.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:v="clr-namespace:TimeLiner.Views"
    xmlns:vm="clr-namespace:TimeLiner.ViewModels"
    x:Name="_timeLinesView"
    d:DesignHeight="450"
    d:DesignWidth="800"
    PreviewMouseWheel="UserControl_PreviewMouseWheel"
    mc:Ignorable="d"
    >

    <Control.Resources>

        <Style x:Key="VerticalScrollBarStyle"
               BasedOn="{StaticResource Fluent.Ribbon.Styles.ScrollBar}"
               TargetType="ScrollBar">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=VerticalScrollMaximum}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HorizontalScrollBarStyle"
               BasedOn="{StaticResource Fluent.Ribbon.Styles.ScrollBar}"
               TargetType="ScrollBar">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=HorizontalScrollMaximum}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Timelines  -->
        <DataTemplate DataType="{x:Type vm:TimeLineViewModel}">
            <ItemsControl ItemsSource="{Binding Path=TimeLineItemCollectionView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <v:TimeLineView />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!--  Timeline item  -->
        <DataTemplate DataType="{x:Type vm:TimeLineItemViewModel}">
            <v:TimeLineItemView />
        </DataTemplate>

    </Control.Resources>

    <Border BorderThickness="1" >

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <v:TimeScaleView
                x:Name="TimeScale"
                Grid.Row="0"
                Grid.Column="0"
                Height="18"
                GridWidth="{Binding Source={StaticResource Locator}, Path=Settings.TimeGridWidth}"
                Interval="{Binding Path=ScaleInterval}"
                LeftMargin="{Binding Source={StaticResource Locator}, Path=Settings.TimeLineSpacerLeft}"
                ScrollOffset="{Binding Path=HorizontalScrollOffset}"
                Unit="{Binding Path=ScaleUnit}"
                VisibleWidth="{Binding Path=TimeLinesVisibleWidth}" />

            <Grid Grid.Row="1" Grid.Column="0">

                <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <DockPanel.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding Path=NewTimeLineItemCommand}" Header="New Item" />
                            <MenuItem Command="{Binding Path=NewTimeLineCommand}" Header="New Timeline" />
                        </ContextMenu>
                    </DockPanel.ContextMenu>

                    <!--  The timelines  -->
                    <ItemsControl
                        x:Name="TimeLines"
                        HorizontalAlignment="Stretch"
                        DataContextChanged="TimeLines_DataContextChanged"
                        ItemsSource="{Binding Path=TimeLineCollectionView}"
                        PreviewMouseDoubleClick="TimeLines_PreviewMouseDoubleClick"
                        PreviewMouseLeftButtonDown="TimeLines_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="TimeLines_PreviewMouseLeftButtonUp"
                        PreviewMouseMove="TimeLines_PreviewMouseMove"
                        PreviewMouseRightButtonDown="TimeLines_PreviewMouseRightButtonDown"
                        PreviewMouseRightButtonUp="TimeLines_PreviewMouseRightButtonUp"
                        SizeChanged="TimeLines_SizeChanged">

                        <!--  The background grid  -->
                        <ItemsControl.Background>

                            <DrawingBrush TileMode="Tile" ViewportUnits="Absolute">
                                <DrawingBrush.Viewport>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <c:RectConverter />
                                        </MultiBinding.Converter>
                                        <!--  X  -->
                                        <Binding Path="Settings.TimeLineSpacerLeft" Source="{StaticResource Locator}" />
                                        <!--  Y  -->
                                        <Binding>
                                            <Binding.Source>
                                                <sys:Double>0</sys:Double>
                                            </Binding.Source>
                                        </Binding>
                                        <!--  Width  -->
                                        <Binding ElementName="_timeLinesView" Path="GridWidth" />
                                        <!--  Height  -->
                                        <Binding ElementName="_timeLinesView" Path="GridHeight" />
                                    </MultiBinding>
                                </DrawingBrush.Viewport>
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry>
                                                <RectangleGeometry.Rect>
                                                    <MultiBinding>
                                                        <MultiBinding.Converter>
                                                            <c:RectConverter />
                                                        </MultiBinding.Converter>
                                                        <!--  X  -->
                                                        <Binding>
                                                            <Binding.Source>
                                                                <sys:Double>0</sys:Double>
                                                            </Binding.Source>
                                                        </Binding>
                                                        <!--  Y  -->
                                                        <Binding>
                                                            <Binding.Source>
                                                                <sys:Double>0</sys:Double>
                                                            </Binding.Source>
                                                        </Binding>
                                                        <!--  Width  -->
                                                        <Binding ElementName="_timeLinesView" Path="GridWidth" />
                                                        <!--  Height  -->
                                                        <Binding ElementName="_timeLinesView" Path="GridHeight" />
                                                    </MultiBinding>
                                                </RectangleGeometry.Rect>
                                            </RectangleGeometry>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="{DynamicResource TimeLineGridBrush}" Thickness="1" />
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                                <DrawingBrush.Transform>
                                    <TranslateTransform X="{Binding Path=GridOffsetHorizontal}" />
                                </DrawingBrush.Transform>
                            </DrawingBrush>
                        </ItemsControl.Background>
                    </ItemsControl>

                </DockPanel>

                <!--  The timeline selector  -->
                <v:TimeLineSelectorView
                    x:Name="TimeLineSelector"
                    Panel.ZIndex="-1"
                    DataContext="{Binding Path=TimeLineSelectorViewModel}"
                    Color="Blue"
                    />

                <!--  The start-time locator  -->
                <v:TimeLocatorView
                    x:Name="StartTimeLocator"
                    DataContext="{Binding Path=StartTimeLocatorViewModel}"
                    Color="{DynamicResource StartTimeLocatorColor}"
                    />

                <!--  The end-time locator  -->
                <v:TimeLocatorView
                    x:Name="EndTimeLocator"
                    DataContext="{Binding Path=EndTimeLocatorViewModel}"
                    Color="{DynamicResource EndTimeLocatorColor}"                    
                    />

                <!--  The selected-time locator (always hidden)  -->
                <v:TimeLocatorView
                    x:Name="SelectedTimeLocator"
                    DataContext="{Binding Path=SelectedTimeLocatorViewModel}"
                    Visibility="Hidden"
                    />

                <!--  The zoom tool  -->
                <v:ZoomToolView 
                    x:Name="ZoomView" 
                    DataContext="{Binding Path=ZoomToolViewModel}"
                    />

            </Grid>

            <!--  Scroll the timelines vertically  -->
            <ScrollBar
                Grid.Row="1"
                Grid.Column="1"
                LargeChange="{Binding Path=VerticalScrollLargeChange}"
                Maximum="{Binding Path=VerticalScrollMaximum}"
                Minimum="{Binding Path=VerticalScrollMinimum}"
                Orientation="Vertical"
                SmallChange="{Binding Path=VerticalScrollSmallChange}"
                Style="{StaticResource VerticalScrollBarStyle}"
                ViewportSize="{Binding Path=TimeLinesVisibleHeight}"
                Value="{Binding Path=VerticalScrollOffset, Mode=TwoWay}"
                />

            <!--  Scroll the timelines horizontally  -->
            <ScrollBar
                Grid.Row="2"
                Grid.Column="0"
                LargeChange="{Binding Path=HorizontalScrollLargeChange}"
                Maximum="{Binding Path=HorizontalScrollMaximum}"
                Minimum="{Binding Path=HorizontalScrollMinimum}"
                Orientation="Horizontal"
                SmallChange="{Binding Path=HorizontalScrollSmallChange}"
                Style="{StaticResource HorizontalScrollBarStyle}"
                ViewportSize="{Binding Path=TimeLinesVisibleWidth}"
                Value="{Binding Path=HorizontalScrollOffset, Mode=TwoWay}"
                />
        </Grid>

    </Border>

</UserControl>
