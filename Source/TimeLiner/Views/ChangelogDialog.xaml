<ui:BaseRibbonWindow
    x:Class="TimeLiner.Views.ChangelogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:TimeLiner.UI"
    Title="What's new?"
    Width="800" Height="600" MinWidth="450" MinHeight="300"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource WindowBackgroundBrush}"
    Closed="Dialog_Closed"
    PreviewKeyDown="Dialog_KeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox
            Text="{Binding Text, Mode=OneWay}"
            Style="{StaticResource TextBoxStyle}"
            FontFamily="Consolas" FontSize="14"
            Background="{DynamicResource TimeLineGridBackgroundBrush}"
            Padding="12"
            IsReadOnly="True" IsUndoEnabled="False"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            AutomationProperties.Name="Changelog">
            <TextBox.Resources>
                <Style TargetType="{x:Type ScrollBar}"
                       BasedOn="{StaticResource Fluent.Ribbon.Styles.ScrollBar}" />
            </TextBox.Resources>
        </TextBox>
        <Button Grid.Row="1"
            Content="Close" Command="{Binding CloseCommand}"
            Style="{StaticResource DialogButtonStyle}"
            Width="90" Margin="0,12,0,0" HorizontalAlignment="Right" />
    </Grid>
</ui:BaseRibbonWindow>