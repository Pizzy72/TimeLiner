<UserControl x:Class="TimeLiner.Views.TimeDisplayView"
    Focusable="True" IsTabStop="False" FocusVisualStyle="{x:Null}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:f="urn:fluent-ribbon"
    xmlns:c="clr-namespace:TimeLiner.Converter"
    xmlns:v="clr-namespace:TimeLiner.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <c:TimeZoneInfoConverter x:Key="TimeZoneInfoConverter" />
        <DataTemplate x:Key="SelectedTimeZoneTemplate">
            <TextBlock Text="{Binding DisplayName, Converter={StaticResource TimeZoneInfoConverter}}"
                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DataTemplate>
        <DataTemplate x:Key="TimeZoneTemplate">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" ToolTip="{Binding DisplayName}" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <f:ComboBox x:Name="DisplayModeComboBox"
            Header="Display"
            f:InputControlProperties.InputWidth="200"
            IsEditable="False"
            DisplayMemberPath="Value"
            ItemsSource="{Binding DisplayModes}"
            SelectedValue="{Binding DisplayMode}"
            SelectedValuePath="Key"
            PreviewKeyDown="TimeSelection_PreviewKeyDown"
            ToolTip="Regional time or a fixed UTC offset. Toggle with T." />
        <f:ComboBox x:Name="TimeZoneComboBox"
            Header="Time zone"
            f:InputControlProperties.InputWidth="200"
            IsEditable="False"
            Visibility="{Binding IsRegionalTime, Converter={StaticResource BooleanToVisibilityConverter}}"
            ItemTemplateSelector="{v:ComboBoxTemplateSelector SelectedItemTemplate={StaticResource SelectedTimeZoneTemplate}, DropdownItemsTemplate={StaticResource TimeZoneTemplate}}"
            ItemsSource="{Binding TimeZones}"
            SelectedValue="{Binding TimeZone}"
            SelectedValuePath="Id"
            PreviewKeyDown="TimeSelection_PreviewKeyDown"
            ToolTip="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource Self}}" />
        <Grid Visibility="{Binding IsFixedOffset, Converter={StaticResource BooleanToVisibilityConverter}}">
            <f:ComboBox x:Name="UtcOffsetComboBox"
                Header="UTC offset"
                f:InputControlProperties.InputWidth="200"
                IsEditable="True"
                IsTextSearchEnabled="False"
                MaxDropDownHeight="360"
                Visibility="{Binding IsFixedOffset, Converter={StaticResource BooleanToVisibilityConverter}}"
                ItemsSource="{Binding OffsetOptions}"
                Text="{Binding OffsetInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PreviewKeyDown="UtcOffsetComboBox_PreviewKeyDown"
                LostKeyboardFocus="UtcOffsetComboBox_LostKeyboardFocus"
                DropDownClosed="UtcOffsetComboBox_DropDownClosed"
                ToolTip="Enter ±HH:mm, or select First event to use its original start offset in file order. UTC is +00:00. Enter commits; Escape cancels." />
            <Border BorderBrush="Red" BorderThickness="1" IsHitTestVisible="False"
                Visibility="{Binding HasOffsetError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
        <TextBlock Text="{Binding TimeDisplayHint}"
            Foreground="{DynamicResource TextColorBrush}"
            FontSize="11" MaxWidth="265" TextWrapping="Wrap" Margin="3,3,0,0" />
    </StackPanel>
</UserControl>
