<ui:BaseRibbonWindow
    x:Class="TimeLiner.Views.InfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:TimeLiner.UI"    
    xmlns:f="urn:fluent-ribbon"
    Title="Info"
    Width="450"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    Closed="InfoDialog_Closed"
    KeyDown="Window_KeyDown"
    DataContext="{Binding Source={StaticResource Locator}, Path=InfoDialog}"
    mc:Ignorable="d"
    >

    <ui:BaseRibbonWindow.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ui:BaseRibbonWindow.Resources>

    <StackPanel
        Margin="50,20,50,30"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Vertical"
        >
 
        <TextBlock Text="{Binding ProductName}" />
        <TextBlock Text="{Binding Version}" />
        <TextBlock Text="{Binding Copyright}" />
 
        <Button
            Style="{StaticResource DialogButtonStyle}"
            Width="80"
            Margin="0,25,0,0"
            Content="OK"
            IsDefault="True"
            Click="Button_Click" 
            />
    </StackPanel>
    
</ui:BaseRibbonWindow>
