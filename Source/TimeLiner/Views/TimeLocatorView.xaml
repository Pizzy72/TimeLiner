<UserControl
    x:Class="TimeLiner.Views.TimeLocatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="80"
    d:DesignWidth="10"
    DataContextChanged="TimeLocator_DataContextChanged"
    PreviewMouseLeftButtonDown="TimeLocator_PreviewMouseLeftButtonDown"
    PreviewMouseMove="TimeLocator_PreviewMouseMove"
    PreviewMouseUp="TimeLocator_PreviewMouseUp"
    ToolTip="{Binding Path=ToolTip}"
    ToolTipService.InitialShowDelay="0"
    ToolTipService.BetweenShowDelay="0"
    mc:Ignorable="d"
    >

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
   
    <Canvas x:Name="Canvas"
            Visibility="{Binding Path=IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            >
        <Line
            x:Name="Line"
            Opacity="0.5"
            PreviewMouseMove="Line_PreviewMouseMove"
            Stroke="Black"
            StrokeDashArray="5 1"
            StrokeThickness="2"
            X1="0"
            X2="0"
            Y1="0"
            Y2="{Binding ElementName=Canvas, Path=ActualHeight}"
            />
    </Canvas>
</UserControl>
